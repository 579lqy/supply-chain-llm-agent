# 复制为 config.env 并填值（config.env 已被 .gitignore 忽略，不会提交）

# 后端选择：rulebased（默认，零依赖） | openai（真 LLM）
LLM_BACKEND=rulebased

# ---- 仅当 LLM_BACKEND=openai 时需要 ----
# OpenAI 兼容接口（可替换为 DeepSeek / 通义 / 智谱 / 本地 Ollama 的 base_url）
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- 可选：在线 embedding（不填则优先用本地 sentence-transformers）----
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
